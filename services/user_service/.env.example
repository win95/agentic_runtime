# User service — copy to .env and fill in. NEVER commit a real .env.
# Secrets are intentionally left empty here; all credentials come from
# the environment.

# Own database on the shared Postgres server (created by
# docker/postgres/01-create-user-service-db.sql on first init, or
# manually: createdb user_service). Never the platform's DATABASE_URL.
USER_SERVICE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/user_service

# Shared with the platform API (app/config.py: jwt_secret) — the service
# signs tokens with it, the API verifies them. The two values MUST match.
# Empty = JWT auth is not configured.
JWT_SECRET=

# One-off admin seed (make seed-admin). Empty = seeding refuses to run.
ADMIN_EMAIL=
ADMIN_PASSWORD=
