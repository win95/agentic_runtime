# Agentic Runtime — copy to .env and fill in. NEVER commit a real .env.
# Secrets are intentionally left empty here; all credentials come from the
# environment. Defaults below are dev-only (see docker-compose.yml).

# --- Platform ---
APP_NAME=agentic-runtime
ENVIRONMENT=dev
# API key for the Platform API (X-API-Key header). Empty = auth disabled (dev only).
API_KEY=
# JWT secret shared with the user service (services/user_service): the
# service signs tokens with it, the API verifies them. The two values
# MUST match. Empty = JWT auth is not configured.
JWT_SECRET=

# --- User service (services/user_service) ---
# Own database on the shared Postgres server — never the platform's DATABASE_URL.
USER_SERVICE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/user_service
# One-off admin seed (make seed-admin). Empty = seeding refuses to run.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- PostgreSQL (missions, agents, tools, executions, results) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentic_runtime

# --- Celery + Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- LLM — LiteLLM OpenAI-compatible proxy (REQUIRED for real runs) ---
# The 4 values you must fill in:
#   LLM_API_BASE  — your LiteLLM proxy URL (e.g. http://localhost:4000)
#   LLM_API_KEY   — the API key for that proxy (empty here on purpose)
#   LLM_MODEL     — the chat model name AS REGISTERED on your LiteLLM proxy
#   EMBEDDING_MODEL — the embedding model name AS REGISTERED on your proxy
# Placeholders below are examples only; they must match your proxy's config.
LLM_API_BASE=http://localhost:4000
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
# Embedding model (defaults: same proxy as the LLM when left empty).
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Alternative provider (needs: pip install -e ".[anthropic]"). The LiteLLM
# factory above is the default; Anthropic is only a documented alternative.
ANTHROPIC_API_KEY=

# --- LangSmith (observability only; tracing off unless explicitly enabled) ---
# Tracing is standard env-based LangSmith tracing: runs of the Mission
# Graph / Deep Agent appear under LANGSMITH_PROJECT. Set LANGSMITH_TRACING
# to true and fill LANGSMITH_API_KEY to enable it.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-runtime
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Qdrant (document embeddings / RAG) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=technical_documents

# --- Neo4j (knowledge graph) ---
GRAPH_DATABASE_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# --- MinIO (files, artifacts, reports) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=agentic-runtime
# Bucket for execution Markdown reports (executions/<id>/report.md).
MINIO_REPORTS_BUCKET=reports
MINIO_SECURE=false

# --- MLflow 3.x (primary observability: tracing, eval, prompt registry) ---
# MLFLOW_TRACKING_URI — the MLflow 3.x server (compose service `mlflow`,
# profile `observability`). GenAI endpoints need a 3.x server.
MLFLOW_TRACKING_URI=http://localhost:5000
# Experiment for traces + eval runs.
MLFLOW_EXPERIMENT=agentic-runtime
# Set to false to disable MLflow tracing (LangSmith is independent).
MLFLOW_TRACING_ENABLED=true
# S3 artifact access for the MLflow *client* (eval/tracing on this machine).
# The compose server stores artifacts in MinIO (S3), so logging an artifact
# (e.g. `make eval` uploads report.md) needs boto3 + these three vars.
# They mirror MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY above.
# Without them, `make eval` fails with "No module named 'boto3'" (if boto3
# is missing) or an S3 endpoint/credentials error (if it is installed).
# Local-only alternative (no server, no S3): run eval with
#   python scripts/eval_mission.py --mock-llm --tracking-uri sqlite:///tmp/mlflow-test/mlflow.db
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- MCP (generic MCP server adapter; no hardcoded URL/token) ---
MCP_SERVER_URL=
MCP_TRANSPORT=streamable_http
# Layer 4: which capability each MCP tool belongs to, as JSON
# {"tool_name": "capability"}. An MCP tool with no mapping is DENIED
# (never handed to an agent). Example:
# MCP_TOOL_CAPABILITIES={"office_listings": "market_read"}

# --- Batch ingest (Option B) ---
# Files land in a local dir (default ingest/inbox) or, when true, in the
# MinIO bucket below. Beat runs the batch every INGEST_INTERVAL_SECONDS.
INGEST_INTERVAL_SECONDS=1800
INGEST_INBOX_DIR=ingest/inbox
INGEST_USE_MINIO=false
INGEST_MINIO_BUCKET=ingest-inbox

# --- Slack notifications (Incoming Webhook, #agent-activity) ---
# Webhook URL for the workspace's Incoming Webhook app. Empty = no
# notifications are sent. Fill in with the real URL (secret — .env only,
# never committed). See docs/slack-notifications.md.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#agent-activity
SLACK_NOTIFICATIONS_ENABLED=true

# --- OpenSandbox sandbox backend (docs/sandbox.md) ---
# One sandbox per session for the fault_investigator agent. The server
# must be running first (uvx opensandbox-server ... — see the doc).
# SANDBOX_ENABLED=false (default) keeps the in-memory backend.
SANDBOX_ENABLED=false
SANDBOX_DOMAIN=localhost:8080
SANDBOX_API_KEY=
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_USE_SERVER_PROXY=false
SANDBOX_IDLE_TTL_SECONDS=3600

# --- MCP — generic server (docs/hotel-reception.md) ---
# One MCP server URL; tools it exposes are mapped to capabilities
# below. Empty URL = no MCP tools. The mock hotel server
# (scripts/mock_hotel_mcp_server.py) runs on 127.0.0.1:8081.
MCP_SERVER_URL=
MCP_TRANSPORT=streamable_http
# JSON {"tool_name": "capability"} — an MCP tool with no mapping here
# is DENIED (never handed to an agent). For the mock (or real) hotel
# server, map all 14 tools to hotel_reception:
MCP_TOOL_CAPABILITIES={"check_room_availability": "hotel_reception", "get_room_rates": "hotel_reception", "find_guest": "hotel_reception", "register_guest": "hotel_reception", "create_booking": "hotel_reception", "get_booking": "hotel_reception", "cancel_booking": "hotel_reception", "change_booking_dates": "hotel_reception", "list_staff": "hotel_reception", "create_task": "hotel_reception", "assign_task": "hotel_reception", "get_task": "hotel_reception", "search_policy_documents": "hotel_reception", "read_policy_document": "hotel_reception"}

# --- Runtime ---
CHECKPOINT_ENABLED=false
EXECUTION_TIMEOUT_SECONDS=3600
