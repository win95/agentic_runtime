# Mission {mission_id} — generated by scripts.new_agent
mission_id: {mission_id}
version: 1
name: {mission_title}
objective: >
  {mission_objective}

input_schema:
  type: object
  properties:
    message:
      type: string
  required:
    - message

execution:
  mode: autonomous
  agent_id: {agent_id}
  skills:
    - {skill_slug}
    - session-memory

capabilities:
  - {capability}

harness: {{}}

output_schema:
  type: object
  properties:
    answer:
      type: string
    actions_taken:
      type: array